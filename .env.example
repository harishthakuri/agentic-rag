# Copy to `.env` and fill in. Never commit `.env`.

# --- Application -------------------------------------------------------------
APP_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=false              # true in production
CORS_ORIGINS=[]             # JSON list, e.g. ["http://localhost:3000"]
AUTH_ENABLED=true           # API keys: make api-key name=dev

# --- Database ----------------------------------------------------------------
# Roles are created by scripts/db/001_roles.sql.
# URL-encode special characters in passwords (@ → %40, : → %3A, / → %2F, # → %23).
# Runtime (DML only):
DATABASE_URL=postgresql+asyncpg://simple_rag_app:CHANGE_ME@localhost:5432/simple-rag-db
# Migrations only (schema owner, DDL):
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://simple_rag_owner:CHANGE_ME@localhost:5432/simple-rag-db
DB_ECHO=false

# --- Chat / agent LLM (any OpenAI-compatible endpoint) -----------------------
# Local (default): Ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b
LLM_REASONING_EFFORT=low    # low | medium | high (reasoning models); empty otherwise
# OpenAI: change only these three lines
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<openai-model-name>

# --- Embeddings --------------------------------------------------------------
# Changing the model or dimension requires re-embedding existing collections.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# --- Ingestion ---------------------------------------------------------------
MAX_UPLOAD_MB=25
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
INGESTION_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=2
# PDFs: pypdf (fast, text only) or docling (headings, tables, OCR for scans; slower).
# Docling needs: uv sync --extra docling. Its models download on the first PDF.
PDF_PARSER=pypdf            # pypdf | docling
# DOCLING_OCR=auto          # auto (macOS Vision on a Mac, else RapidOCR) | ocrmac | rapidocr | easyocr | tesseract | off
# DOCLING_TABLES=true
# DOCLING_TIMEOUT_SECONDS=600   # then pypdf is used; keep below WORKER_JOB_LEASE_SECONDS

# --- Retrieval ---------------------------------------------------------------
RERANKER=llm                # llm | cross_encoder | none
# RERANKER_MODEL=           # defaults to LLM_MODEL
RERANKER_REASONING_EFFORT=low   # empty for non-reasoning models
RERANK_DEPTH=10             # first-stage candidates the reranker re-orders (latency!)
# Cross-encoder (RERANKER=cross_encoder; install with: uv sync --extra rerank)
# CROSS_ENCODER_MODEL=Qwen/Qwen3-Reranker-0.6B  # default; or BAAI/bge-reranker-v2-m3 (faster, weaker)
# CROSS_ENCODER_DEVICE=                        # mps | cuda | cpu; empty: best available

# --- Answering (/ask) -------------------------------------------------------
ANSWER_CONTEXT_TOKENS=3000  # token budget for sources in the prompt
ANSWER_MIN_RERANK_GRADE=1   # drop reranked chunks graded below this (0-3)
ANSWER_MIN_CROSS_ENCODER_SCORE=0.02  # the same for the cross-encoder (scores 0..1)

# --- Agent (/agent/ask) -----------------------------------------------------
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=180
AGENT_SEARCH_TOP_K=5
AGENT_RERANK=false

# --- Storage -----------------------------------------------------------------
STORAGE_DIR=./data/uploads

# --- Observability (OpenTelemetry; docs/OBSERVABILITY_PLAN.md) -----------------
# Start the backends with: make obs-grafana / make obs-langfuse (or make obs-up)
OBSERVABILITY_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318          # Grafana LGTM; empty: don't send there
LANGFUSE_BASE_URL=                           # http://localhost:3001 to send traces to Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev          # created by observability/langfuse on first start
LANGFUSE_SECRET_KEY=sk-lf-local-dev
OBSERVABILITY_CAPTURE_CONTENT=false          # prompts/answers to Langfuse only (never Grafana)
# OBSERVABILITY_SAMPLE_RATIO=1.0
# OBSERVABILITY_ENVIRONMENT=dev
